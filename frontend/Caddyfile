# Serves the Vite build in dist/ (see nixpacks.toml). Replaces the default
# Nixpacks Caddyfile so the prerendered per-route pages are used:
# /bike/<slug>-<id> is served from dist/bike/<slug>-<id>/index.html, and any
# path without its own file falls back to the SPA shell (dist/index.html).
{
	admin off
	auto_https off
	servers {
		# Coolify's proxy sits in front of this container
		trusted_proxies static private_ranges
	}
}

:{$PORT:3000} {
	root * dist
	encode zstd gzip

	# One canonical host
	@www host www.katinginbikes.com
	redir @www https://katinginbikes.com{uri} permanent

	# Hashed build output never changes. No SPA fallback here, so a stale
	# hash 404s instead of returning HTML that would be cached as a script.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /static_data/* {
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Pages and the SPA fallback: always revalidate so a new deploy shows at once
	handle {
		header Cache-Control "no-cache"
		try_files {path} {path}/index.html /index.html
		file_server
	}
}
