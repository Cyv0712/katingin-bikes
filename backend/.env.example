PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/jettlaudonedeal
CORS_ORIGIN=http://localhost:5173

# Required in production: enables secure cookie flags, and required for the
# server to boot at all once CORS_ORIGIN/JWT_SECRET/ADMIN_PASSWORD checks apply.
# NODE_ENV=production

# Uploaded images are stored on disk under backend/uploads/

# Admin Credentials (highly recommended to use ADMIN_PASSWORD_HASH)
# Run `npm run generate-hash` to generate a secure bcrypt hash of your password
ADMIN_PASSWORD_HASH=your_secure_bcrypt_hash
# Optional legacy plaintext fallback (not recommended for production):
# ADMIN_PASSWORD=your_secure_password

# JWT Secret Key (required for production). Use a strong random value.
JWT_SECRET=your_secure_jwt_secret_key

# Email Inquiry Notification (sent via the Resend HTTP API)
RESEND_API_KEY=your_resend_api_key
# Optional: defaults to Resend's free-tier sender if omitted
# RESEND_SENDER_EMAIL=your_verified_sender@yourdomain.com
INQUIRY_RECEIVER_EMAIL=katingin.bikes@gmail.com

